## Core
OVERLEAF_APP_NAME="Zeus WPI Overleaf"
ENABLED_LINKED_FILE_TYPES="project_file,project_output_file"
# Enables Thumbnail generation using ImageMagick
ENABLE_CONVERSIONS="true"
# Disables email confirmation requirement
EMAIL_CONFIRMATION_DISABLED="true"

## MongoDB
OVERLEAF_MONGO_URL="mongodb://mongo:27017/sharelatex"

## Redis
OVERLEAF_REDIS_HOST="redis"
OVERLEAF_REDIS_PORT="6379"
REDIS_HOST="redis"
REDIS_PORT="6379"

## Auth
EXTERNAL_AUTH="none"

## History service
V1_HISTORY_URL="http://sharelatex:3100/api"

## Git bridge
GIT_BRIDGE_ENABLED="false"

## Compiler
DOCKER_RUNNER="true"
SANDBOXED_COMPILES="true"
SANDBOXED_COMPILES_SIBLING_CONTAINERS="true"
SANDBOXED_COMPILES_HOST_DIR_COMPILES="${PWD}/data/overleaf-data/compiles"
SANDBOXED_COMPILES_HOST_DIR_OUTPUT="${PWD}/data/overleaf-data/output"
SECCOMP_PROFILE="${PWD}/config/overleaf-clsi-seccomp-profile.json"
TEXLIVE_IMAGE="registry.gitlab.com/islandoftex/images/texlive:TL2025-2025-08-31-full"
TEXLIVE_IMAGE_USER="texlive"
